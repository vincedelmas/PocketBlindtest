<resources>
    <style name="AppTheme" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">#EDE0C8</item>
        <item name="colorOnPrimary">#1C160E</item>
        <item name="colorSecondary">#7EE0A3</item>
        <item name="colorOnSecondary">#0D2618</item>
        <item name="colorSecondaryContainer">#202428</item>
        <item name="colorOnSecondaryContainer">#EDE8DE</item>
        <item name="colorError">#FFB4AB</item>
        <item name="colorOnError">#690005</item>
        <item name="actionOverflowMenuStyle">@style/AppOverflowMenu</item>
        <item name="popupMenuStyle">@style/AppOverflowMenu</item>
        <item name="colorOutline">#3A3F45</item>
        <item name="colorOutlineVariant">#262A2E</item>
        <item name="colorSurface">#121416</item>
        <item name="colorSurfaceContainer">#16181A</item>
        <item name="colorSurfaceContainerHigh">#1D2023</item>
        <item name="colorSurfaceContainerHighest">#25292D</item>
        <item name="colorOnSurface">#F5F1E8</item>
        <item name="colorOnSurfaceVariant">#A8A6A0</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">#0C0D0E</item>
        <item name="materialButtonStyle">@style/AppButton</item>
        <item name="textInputStyle">@style/Widget.Material3.TextInputLayout.OutlinedBox</item>
    </style>
    <style name="AppOverflowMenu" parent="Widget.Material3.PopupMenu.Overflow">
        <item name="android:popupBackground">@drawable/menu_surface</item>
        <item name="android:popupElevation">16dp</item>
        <item name="android:dropDownVerticalOffset">8dp</item>
    </style>
    <style name="AppButton" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">20dp</item>
        <item name="android:minHeight">54dp</item>
    </style>
</resources>
